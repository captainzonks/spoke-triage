# ==============================================================================
# TRIAGE MODULE - ENVIRONMENT VARIABLES
# ==============================================================================
# Description: Module-specific environment defaults for spoke-triage
# Author: Matt Barham
# Created: 2026-09-09
# Version: 0.1.0
# Host: Your Server
# ==============================================================================
# Type: Template
# Security Level: LOW - No secrets here; passwords/API keys are Docker
#                 secrets (see stack.yml), never env vars.
# Component: module: triage
# ==============================================================================
# Note: This file provides module defaults. Hub base.env variables are merged
#       automatically by Spoke. Site-specific overrides go in modules.yml.
# ==============================================================================

#### IMAGES

TRIAGE_COLLECTOR_TAG=0.1.0
TRIAGE_COLLECTOR_IMAGE=${INSTANCE_NAME}/triage-collector:${TRIAGE_COLLECTOR_TAG}

TRIAGE_ANALYST_TAG=0.1.0
TRIAGE_ANALYST_IMAGE=${INSTANCE_NAME}/triage-analyst:${TRIAGE_ANALYST_TAG}

TRIAGE_EGRESS_GUARD_TAG=0.1.0
TRIAGE_EGRESS_GUARD_IMAGE=${INSTANCE_NAME}/triage-egress-guard:${TRIAGE_EGRESS_GUARD_TAG}

#### DATABASE (uses hub postgres-hub)

TRIAGE_POSTGRES_DB=triage

#### LOKI

TRIAGE_LOKI_BASE_URL=http://loki:3100
TRIAGE_LOKI_TENANT_ID=fake
TRIAGE_LOOKBACK_HOURS=24
TRIAGE_EXEMPLAR_LIMIT=3

#### ANTHROPIC MODEL AND COST CONTROL

TRIAGE_MODEL=claude-haiku-4-5
TRIAGE_MONTHLY_BUDGET_USD=20
TRIAGE_MAX_TOKENS=4096
# Caps templates sent to a single Messages call (highest-count first, see
# analyst/src/config.rs) so a cold verdict table can't blow the 200K-token
# context — observed 2129 templates -> 1.65M tokens on the first live run.
TRIAGE_MAX_TEMPLATES_PER_RUN=150
TRIAGE_KNOWN_PATTERNS_PATH=/app/known_patterns.md

#### EGRESS GUARD

TRIAGE_EGRESS_ANTHROPIC_HOST=api.anthropic.com
TRIAGE_EGRESS_REFRESH_SECONDS=300

#### MAIL (spoke-mail-relay owns the From address; not set here)

TRIAGE_MAIL_RELAY_HOST=mail-relay
TRIAGE_MAIL_RELAY_PORT=8000
TRIAGE_MAIL_TO=

#### LOGGING

RUST_LOG=triage=info,sqlx=warn
