# Environment (generated by Spoke)
.env


# Site-specific compose overrides (auto-merged by Docker Compose). Deployment
# data, never part of the module.
docker-compose.override.yml

# Site-specific backup path list read by Spoke's spoke_backup.sh
# (modules/{name}/backup.conf). Instance data, not module code.
backup.conf
# Rust build artifacts
/target/

# Site-specific operator knowledge (see known_patterns.md.example)
known_patterns.md

# Site-specific Grafana datasource (contains a password; see datasource.yaml.example)
grafana/provisioning/datasource.yaml

# Runtime data
appdata/
logs/

# IDE
.idea/
.vscode/
*.swp

# Added by ggshield
.cache_ggshield

# Local / private script inputs (server-specific: known log patterns, etc.).
# Not for public release. Drop any such file under scripts/local/.
scripts/local/

# Local / private docs (server-specific: live IP references, runbooks, secret
# layouts). Not for public release. Drop any such doc under docs/local/.
docs/local/
